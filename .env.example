# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=projexa_internship

# OpenCode (MiMo V2.5 Free)
OPENCODE_API_KEY=your-opencode-api-key
OPENCODE_MODEL=mimo-v2.5-free

# OpenWA
OPENWA_API_URL=http://localhost:2785/api
OPENWA_API_KEY=your-openwa-api-key
OPENWA_SESSION_ID=your-session-id

# JWT (must match web app's JWT_SECRET)
JWT_SECRET=your-jwt-secret
WEBAPP_BASE_URL=http://localhost:3000

# Cloudflare R2 (for document uploads)
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_CDN_BASE_URL=https://your-cdn-domain.com

# Master admin password (impersonation mode)
MASTER_ADMIN_PASSWORD=projexa-sudo

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
